<?xml version="1.0" encoding="utf-8"?>
<!-- Dark band behind the clock, greeting and top buttons, fading to clear, so white text stays readable
     over a bright wallpaper photo while the rest of the picture keeps its brightness. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#B3000000"
        android:centerColor="#4D000000"
        android:endColor="#00000000"
        android:type="linear" />
</shape>
